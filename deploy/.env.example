# The runtime contract (plan §6). The oldbox card sets these; the image has
# defaults for the ones marked default.

# Listen port (default 8080)
PORT=8080
# Absolute base for every link, redirect and mail; never derived from Host
BASE_URL=http://localhost:8082
# The name in the subject tag [<SITE_NAME> #<id>] and the page title
SITE_NAME=localhost

# MariaDB sidecar
DB_HOST=db
DB_PORT=3306
DB_NAME=pyrt
DB_USER=pyrt
DB_PASSWORD=

# Seeds the root user on the first start when no users exist; ignored after
ROOT_PASSWORD=
# The signing key of the session cookie; the app refuses to serve without it
SESSION_SECRET=

# log (default: every message as a JSON log line), file, or smtp
MAIL_MODE=log
# The file MAIL_MODE=file appends to
MAIL_FILE=/var/lib/py-rt/mail.log
# The relay for MAIL_MODE=smtp; ignored otherwise
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=

# Display zone; stored times are UTC
TZ=UTC
# uvicorn workers (default 2)
WORKERS=2

# Standard OpenTelemetry SDK env; the endpoint is a base URL. Unset is a no-op.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=py-rt
OTEL_RESOURCE_ATTRIBUTES=
OTEL_METRIC_EXPORT_INTERVAL=

# Tests and local runs only: overrides the DB_* pair above with a full DSN
DATABASE_URL=
